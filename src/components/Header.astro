---
---
<header class="py-6 flex items-center justify-between">
  <a href="/" class="text-xl font-bold text-green-600 dark:text-green-400">My Tech Blog</a>
  <nav class="flex items-center gap-4 text-sm">
    <a href="/about" class="text-zinc-500 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400">About</a>
    <a href="/search" class="text-zinc-500 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400">Search</a>
    <a href="/rss.xml" class="text-zinc-500 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400">RSS</a>
    <button id="theme-toggle" class="text-zinc-500 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400" aria-label="Toggle theme">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" /></svg>
    </button>
  </nav>
</header>
<hr class="border-zinc-200 dark:border-zinc-800" />

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      if (html.classList.contains('dark')) {
        html.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        html.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  })();
</script>
