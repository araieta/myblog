---
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDate } from '@utils/format-date';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  readingTime: string;
}

const { title, description, date, tags, readingTime } = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article" publishedTime={date.toISOString()}>
  <article class="mt-8">
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map((tag) => (
        <a href={`/tag/${tag}`} class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400">
          {tag}
        </a>
      ))}
    </div>
    <h1 class="text-3xl font-bold mb-2 text-green-600 dark:text-green-400">{title}</h1>
    <p class="text-sm text-zinc-500 mb-8">
      {formatDate(date)} &middot; {readingTime}
    </p>
    <div class="prose dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
